<header id="siteHeader">
  <div class="announcement-bar" id="announcementBar" aria-live="polite">
    <p>Envíos gratis en compras superiores a $299,000 COP. ¡Tu tienda tech con garantía local!</p>
    <button type="button" class="announcement-close" id="announcementClose" aria-label="Cerrar anuncio">✕</button>
  </div>
  <nav class="wrap" role="navigation" aria-label="Menú principal">
    <a href="#siteHeader" class="logo"><img src="{{ 'tz-logo.png' | asset_url }}" alt="Tech Zone" loading="lazy"><span>TECH <b>ZONE</b></span></a>
    <div class="nav-links" id="mainNavLinks">
      <a href="#siteHeader" class="active">Inicio</a>
      <a href="#catalogo" data-navcat="audio">Audio</a>
      <a href="#catalogo" data-navcat="setup">Setup</a>
      <a href="#catalogo" data-navcat="carga">Carga &amp; Conect.</a>
      <a href="#catalogo" data-navcat="almacenamiento">Almacenamiento</a>
      <a href="#catalogo" data-navcat="gaming">Gaming</a>
      <a href="#catalogo" data-navcat="oficina">Oficina</a>
      <a href="#ofertas">Ofertas</a>
    </div>
    <div class="nav-icons">
      <div class="search-wrap" id="searchWrap">
        <label for="searchInput" class="sr-only">Buscar productos</label>
        <input type="text" id="searchInput" placeholder="Buscar productos..." aria-label="Buscar productos">
        <div class="search-suggestions" id="searchSuggestions" aria-label="Sugerencias de búsqueda"></div>
      </div>
      <button type="button" class="icon-btn" id="searchToggle" aria-label="Abrir búsqueda">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <button type="button" class="icon-btn" id="themeToggle" aria-label="Alternar modo oscuro/claro">
        <svg id="themeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.2" y1="4.2" x2="5.6" y2="5.6"/><line x1="18.4" y1="18.4" x2="19.8" y2="19.8"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.2" y1="19.8" x2="5.6" y2="18.4"/><line x1="18.4" y1="5.6" x2="19.8" y2="4.2"/></svg>
      </button>
      <button type="button" class="icon-btn" id="wishlistBtn" aria-label="Ver favoritos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8Z"/></svg><span class="badge-count" id="wishCount">0</span>
      </button>
      <button type="button" class="icon-btn" id="accountBtn" aria-label="{{ customer ? 'Ir a tu cuenta' : 'Iniciar sesión' }}" data-logged-in="{{ customer ? 'true' : 'false' }}" data-account-url="{{ customer ? '/account' : '/account/login' }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        {% if customer %}<span class="sr-only">Cuenta de {{ customer.first_name }}</span>{% endif %}
      </button>
      <button type="button" class="icon-btn" id="cartBtn" aria-label="Abrir carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><span class="badge-count" id="cartCount">0</span>
      </button>
      <button type="button" class="burger" id="burgerBtn" aria-label="Abrir menú móvil" aria-expanded="false" aria-controls="mainNavLinks"><span></span><span></span><span></span></button>
    </div>
    <div class="nav-overlay" id="navOverlay" tabindex="-1" aria-hidden="true"></div>
    <div class="mega-menu" id="megaMenu" aria-hidden="true"></div>
  </nav>
</header>
