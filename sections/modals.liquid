<div class="toast" id="toast"></div>

<nav class="bottom-nav">
  <button data-bn="inicio" class="active"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>Inicio</button>
  <button data-bn="categorias"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Categorías</button>
  <button data-bn="carrito"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>Carrito</button>
  <button data-bn="cuenta"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Cuenta</button>
</nav>

<div class="overlay" id="cartOverlay"></div>
<aside class="drawer" id="cartDrawer">
  <div class="drawer-head"><h3>🛒 Tu carrito</h3><button class="close-btn" id="closeCart">✕</button></div>
  <div class="drawer-body">
    <div id="cartItems"></div>
    <div class="coupon-row"><input type="text" id="couponInput" placeholder="Código de cupón (prueba TZ10)"><button class="btn btn-ghost btn-sm" id="applyCoupon">Aplicar</button></div>
    <div id="couponMsg" class="coupon-msg"></div>
    <div class="ship-calc">
      <span class="field-label" style="margin-top:0;">Calcular envío</span>
      <select id="shipCity"><option value="0">Selecciona tu ciudad</option><option value="0">Quibdó (gratis)</option><option value="12000">Medellín — $12.000</option><option value="15000">Bogotá — $15.000</option><option value="18000">Cali — $18.000</option><option value="22000">Otra ciudad — $22.000</option></select>
    </div>
    <span class="field-label">También te puede interesar</span>
    <div class="rec-row" id="recRow"></div>
  </div>
  <div class="drawer-foot">
    <div class="summary-box">
      <div class="row"><span>Subtotal</span><span id="cartSubtotal">$0</span></div>
      <div class="row"><span>Envío</span><span id="cartShip">$0</span></div>
      <div class="row"><span>Descuento</span><span id="cartDiscount">-$0</span></div>
      <div class="row total"><span>Total</span><span id="cartTotal">$0</span></div>
    </div>
    <div style="display:flex;gap:10px;margin-top:12px;"><button class="btn btn-ghost" id="clearCartBtn" style="flex:1;">Vaciar</button><button class="btn btn-primary" id="goCheckoutBtn" style="flex:1;">Ir a pagar</button></div>
  </div>
</aside>

<div class="modal-overlay" id="checkoutOverlay">
  <div class="modal">
    <div class="modal-head"><h3>📦 Checkout</h3><button class="close-btn" id="closeCheckout">✕</button></div>
    <div class="modal-body">
      <div class="steps" id="checkoutSteps"></div>
      <div id="checkoutContent"></div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="accountOverlay">
  <div class="modal" style="max-width:420px;">
    <div class="modal-head"><h3>👤 Mi cuenta</h3><button class="close-btn" id="closeAccount">✕</button></div>
    <div class="modal-body">
      <div class="acc-tabs">
        <div class="acc-tab active" data-acc="login">Inicio de sesión</div>
        <div class="acc-tab" data-acc="registro">Registro</div>
        <div class="acc-tab" data-acc="recuperar">Recuperar</div>
      </div>
      <div class="acc-panel active" id="acc-login"><input type="email" placeholder="Correo"><input type="password" placeholder="Contraseña"><a class="link" data-acc="recuperar">¿Olvidaste tu contraseña?</a><button class="btn btn-primary" id="loginBtn">Iniciar sesión</button></div>
      <div class="acc-panel" id="acc-registro"><input type="text" placeholder="Nombre completo"><input type="email" placeholder="Correo"><input type="tel" placeholder="Teléfono"><input type="password" placeholder="Contraseña"><button class="btn btn-primary" id="registerBtn">Crear cuenta</button></div>
      <div class="acc-panel" id="acc-recuperar"><input type="email" placeholder="Correo asociado a tu cuenta"><button class="btn btn-primary" id="recoverBtn">Enviar enlace de recuperación</button></div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="productOverlay">
  <div class="modal" style="max-width:820px;">
    <div class="modal-head"><h3 id="pmodalCatName">Producto</h3><button class="close-btn" id="closeProduct">✕</button></div>
    <div class="pmodal-body" id="pmodalBody"></div>
  </div>
</div>

<div class="compare-bar" id="compareBar">
  <div class="items" id="compareItems">0 productos seleccionados para comparar</div>
  <div style="display:flex;gap:10px;"><button class="btn btn-ghost btn-sm" id="clearCompare">Limpiar</button><button class="btn btn-primary btn-sm" id="openCompare">Comparar</button></div>
</div>
<div class="modal-overlay" id="compareOverlay">
  <div class="modal" style="max-width:700px;">
    <div class="modal-head"><h3>⚖️ Comparador de productos</h3><button class="close-btn" id="closeCompare">✕</button></div>
    <div class="modal-body"><div style="overflow-x:auto;"><table class="compare-table" id="compareTable"></table></div></div>
  </div>
</div>
