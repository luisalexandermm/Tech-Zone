<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
{% style %}

  :root{
    --pearl:#F7F7F5; --gray:#ECECEC; --graphite:#171717; --crimson:#C1121F; --magenta:#E63B7A;
    --grad: linear-gradient(100deg, var(--crimson), var(--magenta));
    --radius:14px; --shadow:0 20px 50px -20px rgba(23,23,23,.15);
    --surface:#fff; --text:#171717; --text-soft:#6b6b6b; --border:rgba(23,23,23,.08);
  }
  [data-theme="dark"]{
    --pearl:#121212; --surface:#1b1b1b; --text:#F2F2F0; --text-soft:#a3a3a1; --border:rgba(255,255,255,.08);
    --shadow:0 20px 50px -20px rgba(0,0,0,.6);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{font-family:'Inter',sans-serif;color:var(--text);background:var(--pearl);-webkit-font-smoothing:antialiased;transition:background .3s,color .3s;}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;}
  a{text-decoration:none;color:inherit;}
  button{font-family:inherit;border:none;cursor:pointer;background:none;color:inherit;}
  input,select{font-family:inherit;}
  img,svg{display:block;}
  .wrap{max-width:1240px;margin:0 auto;padding:0 32px;}
  .eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--crimson);}
  .grad-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:15px 28px;border-radius:999px;font-weight:600;font-size:15px;transition:transform .25s ease, box-shadow .25s ease;}
  .btn-primary{background:var(--grad);color:#fff;box-shadow:0 12px 24px -8px rgba(193,18,31,.45);}
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{background:var(--surface);color:var(--text);border:1px solid var(--border);}
  .btn-ghost:hover{border-color:var(--text);}
  .btn-sm{padding:9px 16px;font-size:13px;}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none !important;}

  /* Custom cursor (desktop only) */
  .cursor-dot{position:fixed;top:0;left:0;width:16px;height:16px;border-radius:50%;border:1.5px solid var(--crimson);pointer-events:none;z-index:999;transform:translate(-50%,-50%);transition:width .18s,height .18s,background .18s;mix-blend-mode:difference;}
  .cursor-dot.grow{width:34px;height:34px;background:rgba(230,59,122,.35);}
  @media (pointer:coarse){.cursor-dot{display:none;}}

  /* ---------- NAV ---------- */
  header{position:sticky;top:0;z-index:100;background:transparent;transition:background .3s,box-shadow .3s,border-color .3s;border-bottom:1px solid transparent;}
  header.scrolled{background:rgba(247,247,245,.8);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
  [data-theme="dark"] header.scrolled{background:rgba(18,18,18,.8);}
  nav.wrap{display:flex;align-items:center;justify-content:space-between;height:76px;gap:14px;}
  .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;letter-spacing:.02em;flex:none;}
  .logo img{width:40px;height:auto;display:block;}
  .logo .mark{width:38px;height:38px;border-radius:10px;background:var(--graphite);display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Space Grotesk';font-weight:700;font-size:15px;position:relative;overflow:hidden;flex:none;}
  .logo .mark::after{content:"";position:absolute;inset:0;background:var(--grad);opacity:0;transition:opacity .3s;}
  .logo:hover .mark::after{opacity:1;}
  .logo .mark span{position:relative;z-index:1;}
  .logo b{color:var(--crimson);}
  .nav-links{display:flex;gap:20px;font-size:13.5px;font-weight:500;flex:1;justify-content:center;}
  .nav-links a{position:relative;opacity:.75;transition:opacity .2s;white-space:nowrap;}
  .nav-links a:hover,.nav-links a.active{opacity:1;}
  .nav-links a.active::after{content:"";position:absolute;left:0;right:0;bottom:-22px;height:2px;background:var(--crimson);}
  .nav-icons{display:flex;align-items:center;gap:16px;flex:none;}
  .icon-btn{width:22px;height:22px;display:flex;align-items:center;justify-content:center;position:relative;opacity:.85;}
  .icon-btn:hover{opacity:1;}
  .badge-count{position:absolute;top:-9px;right:-10px;background:var(--crimson);color:#fff;font-size:10px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;}
  .search-wrap{display:flex;align-items:center;overflow:hidden;width:0;transition:width .25s ease;}
  .search-wrap.open{width:190px;}
  .search-wrap input{width:100%;border:1px solid var(--border);border-radius:999px;padding:8px 14px;font-size:13px;background:var(--surface);color:var(--text);}
  .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
  .burger span{width:22px;height:2px;background:var(--text);}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;padding:64px 0 40px;}
  .hero-bg{position:absolute;inset:0;z-index:0;background:radial-gradient(circle at 18% 20%, rgba(230,59,122,.10), transparent 45%),radial-gradient(circle at 82% 60%, rgba(193,18,31,.08), transparent 50%);}
  .particle{position:absolute;border-radius:50%;background:var(--magenta);opacity:.35;filter:blur(1px);animation:drift 9s ease-in-out infinite;}
  @keyframes drift{0%,100%{transform:translateY(0) translateX(0);}50%{transform:translateY(-26px) translateX(10px);}}
  .hero-stage{position:relative;z-index:1;height:400px;border-radius:28px;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;box-shadow: inset 0 0 0 1px var(--border);gap:14px;}
  .hero-stage .ring{position:absolute;width:560px;height:560px;border-radius:50%;border:1px solid var(--border);}
  .hero-stage .ring.r2{width:400px;height:400px;}
  .orb{position:absolute;border-radius:50%;background:radial-gradient(circle at 30% 30%, #fff, #e3e3e1);box-shadow:0 10px 20px -8px rgba(23,23,23,.15);}
  .orb.o1{width:22px;height:22px;top:18%;left:10%;}
  .orb.o2{width:14px;height:14px;bottom:14%;right:14%;}
  .orb.o3{width:34px;height:34px;bottom:8%;left:20%;opacity:.6;}

  .logo3d-wrap{perspective:900px;width:190px;height:130px;position:relative;z-index:2;}
  .logo3d-wrap img{width:100%;height:100%;object-fit:contain;animation:tilt3d 5s ease-in-out infinite;filter:drop-shadow(0 20px 26px rgba(23,23,23,.3));}
  @keyframes tilt3d{0%{transform:rotateY(-16deg) rotateX(5deg) translateY(0);}50%{transform:rotateY(16deg) rotateX(-5deg) translateY(-10px);}100%{transform:rotateY(-16deg) rotateX(5deg) translateY(0);}}

  .peripherals{display:flex;align-items:flex-end;gap:8px;position:relative;z-index:2;}
  .peripherals svg{filter:drop-shadow(0 18px 30px rgba(23,23,23,.18));animation:floatY 4.2s ease-in-out infinite;}
  .peripherals svg:nth-child(2){animation-delay:.25s;} .peripherals svg:nth-child(3){animation-delay:.5s;}
  .peripherals svg:nth-child(4){animation-delay:.75s;} .peripherals svg:nth-child(5){animation-delay:1s;} .peripherals svg:nth-child(6){animation-delay:1.25s;}
  @keyframes floatY{0%,100%{transform:translateY(0);}50%{transform:translateY(-9px);}}

  .hero-copy{text-align:center;max-width:640px;margin:44px auto 0;}
  .hero-copy .eyebrow{display:block;margin-bottom:14px;}
  .hero-copy h1{font-size:52px;line-height:1.05;font-weight:700;letter-spacing:-.01em;}
  .hero-copy p{margin-top:16px;font-size:16.5px;color:var(--text-soft);}
  .hero-actions{display:flex;gap:14px;justify-content:center;margin-top:30px;}

  /* ---------- SECTIONS ---------- */
  .section{padding:70px 0;}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:30px;flex-wrap:wrap;gap:10px;}
  .section-head h2{font-size:28px;font-weight:700;}
  .section-head p.sub{font-size:13.5px;color:var(--text-soft);margin-top:4px;}
  .section-head .view-all{font-size:14px;font-weight:600;opacity:.8;display:flex;align-items:center;gap:4px;}
  .section-head .view-all:hover{opacity:1;color:var(--crimson);}

  .cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;}
  .cat-card{background:var(--surface);border-radius:var(--radius);padding:24px 16px;text-align:left;border:1px solid var(--border);transition:transform .25s ease, box-shadow .25s ease;cursor:pointer;}
  .cat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);}
  .cat-icon{width:48px;height:48px;border-radius:13px;background:var(--pearl);display:flex;align-items:center;justify-content:center;margin-bottom:14px;color:var(--crimson);}
  .cat-card h4{font-size:14.5px;font-weight:700;}
  .cat-card span{font-size:11.5px;color:var(--text-soft);display:block;margin-top:4px;}

  /* ---------- PRODUCT CARD (tilt + glow + wishlist + compare) ---------- */
  .prod-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
  .prod-card{--x:50%;--y:50%;position:relative;background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);overflow:hidden;display:flex;flex-direction:column;transform-style:preserve-3d;transition:transform .12s ease, box-shadow .25s ease;will-change:transform;}
  .prod-card::before{content:"";position:absolute;inset:0;background:radial-gradient(200px circle at var(--x) var(--y), rgba(230,59,122,.16), transparent 60%);opacity:0;transition:opacity .25s;pointer-events:none;z-index:1;}
  .prod-card:hover::before{opacity:1;}
  .prod-card:hover{box-shadow:var(--shadow);}
  .prod-media{position:relative;height:130px;background:linear-gradient(160deg,var(--pearl),var(--border));display:flex;align-items:center;justify-content:center;cursor:pointer;}
  .badge{position:absolute;top:10px;left:10px;font-size:10px;font-weight:700;padding:4px 9px;border-radius:999px;color:#fff;letter-spacing:.02em;z-index:2;}
  .badge.nuevo{background:var(--graphite);} .badge.oferta{background:var(--crimson);} .badge.popular{background:var(--magenta);} .badge.agotado{background:#8b8b8b;}
  .cat-tag{position:absolute;top:10px;right:10px;font-size:9.5px;font-weight:600;padding:3px 8px;border-radius:999px;background:rgba(23,23,23,.06);color:#5c5c5c;z-index:2;}
  .fav-btn{position:absolute;bottom:8px;right:8px;width:28px;height:28px;border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 10px rgba(0,0,0,.12);z-index:2;color:#b5b5b5;}
  .fav-btn.active{color:var(--crimson);}
  .compare-check{position:absolute;bottom:8px;left:8px;z-index:2;display:flex;align-items:center;gap:5px;background:var(--surface);border-radius:999px;padding:3px 9px 3px 4px;font-size:10px;font-weight:600;box-shadow:0 4px 10px rgba(0,0,0,.1);color:var(--text-soft);}
  .prod-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:5px;flex:1;position:relative;z-index:1;}
  .prod-body span.sub-label{font-size:10.5px;color:var(--crimson);font-weight:600;text-transform:uppercase;letter-spacing:.03em;}
  .prod-body h4{font-size:13.5px;font-weight:600;line-height:1.3;cursor:pointer;}
  .stars{font-size:11px;color:#d6a300;display:flex;align-items:center;gap:4px;}
  .stars span{color:#9a9a9a;}
  .price-row{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px;}
  .price{font-weight:700;font-size:14.5px;}
  .price small{display:block;font-weight:400;font-size:10.5px;color:#9a9a9a;text-decoration:line-through;}
  .add-btn{width:32px;height:32px;border-radius:10px;background:var(--graphite);color:#fff;display:flex;align-items:center;justify-content:center;transition:background .2s;flex:none;}
  .add-btn:hover{background:var(--crimson);}
  .stock-note{font-size:10.5px;color:var(--text-soft);}

  .filter-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;}
  .chip{padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;background:var(--surface);border:1px solid var(--border);color:var(--text-soft);transition:all .2s;}
  .chip:hover{border-color:var(--text);color:var(--text);}
  .chip.active{background:var(--grad);color:#fff;border-color:transparent;}
  .catalog-count{font-size:13px;color:var(--text-soft);margin-bottom:18px;}
  .load-more-wrap{display:flex;justify-content:center;margin-top:34px;}

  /* ---------- COUNTDOWN BANNER ---------- */
  .countdown-banner{background:var(--graphite);border-radius:24px;padding:26px 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;color:#fff;}
  .countdown-banner h3{font-size:18px;font-weight:700;}
  .countdown-banner p{font-size:13px;color:#b7b7b5;margin-top:2px;}
  .countdown-timer{display:flex;gap:10px;}
  .countdown-timer div{background:#242424;border-radius:10px;padding:10px 14px;text-align:center;min-width:56px;}
  .countdown-timer b{display:block;font-size:19px;font-family:'Space Grotesk';}
  .countdown-timer span{font-size:9.5px;color:#9a9a9a;text-transform:uppercase;letter-spacing:.05em;}

  /* ---------- SETUP BUILDER ---------- */
  .builder{background:var(--graphite);border-radius:28px;padding:44px;color:#fff;display:grid;grid-template-columns:280px 1fr 300px;gap:28px;}
  .builder h2{font-size:26px;font-weight:700;color:#fff;}
  .builder .lead{color:#b7b7b5;font-size:14px;margin-top:6px;}
  .tabs{display:flex;gap:8px;margin:22px 0 16px;flex-wrap:wrap;}
  .tab{padding:9px 14px;border-radius:999px;font-size:12.5px;font-weight:600;background:#242424;color:#c9c9c7;display:flex;align-items:center;gap:6px;transition:background .2s,color .2s;}
  .tab.active{background:var(--grad);color:#fff;}
  .option-list{display:flex;flex-direction:column;gap:10px;}
  .option{display:flex;align-items:center;gap:12px;background:#1f1f1f;border-radius:12px;padding:10px 12px;border:1px solid transparent;cursor:pointer;transition:border .2s,background .2s;}
  .option:hover{background:#252525;}
  .option.selected{border-color:var(--magenta);background:#241a1e;}
  .option .swatch{width:36px;height:36px;border-radius:9px;background:#333;flex:none;display:flex;align-items:center;justify-content:center;}
  .option .info{flex:1;}
  .option .info h5{font-size:13px;font-weight:600;}
  .option .info span{font-size:11.5px;color:#9a9a9a;}
  .option .dot{width:9px;height:9px;border-radius:50%;background:#3a3a3a;flex:none;}
  .option.selected .dot{background:var(--magenta);}
  .stage-col{display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;}
  .desk{width:100%;height:280px;border-radius:20px;background:linear-gradient(165deg,#232323,#151515);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
  .desk .tz-mark{font-family:'Space Grotesk';font-weight:700;font-size:44px;color:#fff;opacity:.9;letter-spacing:-.02em;}
  .desk .glow{position:absolute;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(230,59,122,.35),transparent 70%);filter:blur(10px);}
  .summary{background:#1f1f1f;border-radius:18px;padding:22px;display:flex;flex-direction:column;}
  .summary h3{font-size:16px;font-weight:700;color:#fff;margin-bottom:14px;}
  .sum-item{display:flex;justify-content:space-between;font-size:13px;padding:9px 0;border-bottom:1px solid #2b2b2b;color:#d5d5d3;}
  .sum-item b{color:#fff;font-weight:600;}
  .sum-total{display:flex;justify-content:space-between;align-items:center;margin-top:14px;padding-top:14px;border-top:1px solid #2b2b2b;}
  .sum-total span{font-size:13px;color:#9a9a9a;}
  .sum-total b{font-size:20px;color:#fff;font-family:'Space Grotesk';}
  .summary .btn-primary{margin-top:16px;width:100%;}

  /* ---------- OFFERS ---------- */
  .offers-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .offer-card{border-radius:var(--radius);overflow:hidden;position:relative;background:linear-gradient(160deg,var(--surface),var(--pearl));border:1px solid var(--border);}
  .offer-media{height:150px;display:flex;align-items:center;justify-content:center;position:relative;}
  .offer-body{padding:18px;}
  .offer-body h4{font-size:15px;font-weight:700;}
  .offer-body p{font-size:12.5px;color:var(--text-soft);margin-top:2px;}
  .offer-price{margin-top:10px;display:flex;align-items:baseline;gap:8px;}
  .offer-price b{font-size:18px;}
  .offer-price small{font-size:12px;color:#9a9a9a;text-decoration:line-through;}
  .offer-body .btn-ghost{margin-top:12px;padding:10px 20px;font-size:13px;}

  /* ---------- BENEFITS ---------- */
  .benefits-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .benefit{text-align:center;padding:20px;}
  .benefit .b-icon{width:52px;height:52px;border-radius:14px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;color:var(--crimson);}
  .benefit h4{font-size:14.5px;font-weight:600;}
  .benefit p{font-size:12.5px;color:var(--text-soft);margin-top:6px;line-height:1.5;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--graphite);color:#e8e8e6;padding:60px 0 90px;}
  .foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:30px;padding-bottom:30px;}
  .foot-brand .logo{color:#fff;}
  .foot-brand p{font-size:13px;color:#9a9a9a;margin-top:12px;line-height:1.6;max-width:260px;}
  .foot-social{display:flex;gap:12px;margin-top:18px;}
  .foot-social a{width:34px;height:34px;border-radius:9px;background:#242424;display:flex;align-items:center;justify-content:center;transition:background .2s;}
  .foot-social a:hover{background:var(--crimson);}
  footer h5{font-size:13px;font-weight:700;margin-bottom:16px;color:#fff;}
  footer ul{list-style:none;display:flex;flex-direction:column;gap:10px;}
  footer ul li a{font-size:13px;color:#9a9a9a;transition:color .2s;}
  footer ul li a:hover{color:#fff;}
  .pay-methods{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}
  .pay-methods span{font-size:10.5px;font-weight:600;padding:5px 10px;border-radius:6px;background:#242424;color:#c9c9c7;}
  .newsletter{display:flex;gap:8px;margin-top:14px;}
  .newsletter input{flex:1;border-radius:999px;border:1px solid #333;background:#1f1f1f;color:#fff;padding:10px 14px;font-size:12.5px;}
  .newsletter button{background:var(--grad);color:#fff;border-radius:999px;padding:10px 18px;font-size:12.5px;font-weight:600;}
  .foot-bottom{border-top:1px solid #262626;padding:20px 0;text-align:center;font-size:12px;color:#7a7a7a;}
  .back-top{position:fixed;bottom:90px;right:26px;width:44px;height:44px;border-radius:50%;background:var(--crimson);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px -8px rgba(193,18,31,.5);z-index:90;opacity:0;pointer-events:none;transition:opacity .3s;}
  .back-top.show{opacity:1;pointer-events:auto;}
  [data-reveal]{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
  [data-reveal].in{opacity:1;transform:translateY(0);}

  /* ---------- OVERLAY / DRAWERS / MODALS ---------- */
  .overlay{position:fixed;inset:0;background:rgba(10,10,10,.5);opacity:0;pointer-events:none;transition:opacity .3s;z-index:200;}
  .overlay.show{opacity:1;pointer-events:auto;}
  .drawer{position:fixed;top:0;right:0;height:100%;width:400px;max-width:90vw;background:var(--surface);z-index:201;transform:translateX(100%);transition:transform .35s ease;display:flex;flex-direction:column;}
  .drawer.show{transform:translateX(0);}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:20px 22px;border-bottom:1px solid var(--border);}
  .drawer-head h3{font-size:17px;font-weight:700;}
  .close-btn{width:30px;height:30px;border-radius:50%;background:var(--pearl);display:flex;align-items:center;justify-content:center;}
  .drawer-body{flex:1;overflow-y:auto;padding:18px 22px;}
  .drawer-foot{padding:18px 22px;border-top:1px solid var(--border);}

  .cart-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);}
  .cart-item .thumb{width:56px;height:56px;border-radius:10px;background:var(--pearl);display:flex;align-items:center;justify-content:center;flex:none;color:var(--text-soft);}
  .cart-item .info{flex:1;}
  .cart-item h5{font-size:13px;font-weight:600;}
  .cart-item .sub{font-size:11px;color:var(--text-soft);}
  .qty-ctrl{display:flex;align-items:center;gap:8px;margin-top:6px;}
  .qty-ctrl button{width:22px;height:22px;border-radius:6px;background:var(--pearl);font-size:13px;font-weight:700;}
  .qty-ctrl span{font-size:12.5px;font-weight:600;min-width:16px;text-align:center;}
  .cart-item .remove{font-size:11px;color:var(--crimson);margin-top:6px;font-weight:600;}
  .cart-item .right{text-align:right;font-weight:700;font-size:13px;}
  .coupon-row{display:flex;gap:8px;margin:14px 0;}
  .coupon-row input{flex:1;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:12.5px;background:var(--pearl);color:var(--text);}
  .coupon-msg{font-size:11.5px;margin-top:6px;font-weight:600;}
  .coupon-msg.ok{color:#1a9e5c;} .coupon-msg.err{color:var(--crimson);}
  .ship-calc select{width:100%;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:12.5px;background:var(--pearl);color:var(--text);margin-top:6px;}
  .rec-row{display:flex;gap:10px;overflow-x:auto;margin-top:8px;padding-bottom:4px;}
  .rec-card{flex:none;width:110px;background:var(--pearl);border-radius:10px;padding:10px;text-align:center;cursor:pointer;}
  .rec-card .ic{color:var(--text-soft);display:flex;justify-content:center;margin-bottom:6px;}
  .rec-card h6{font-size:10.5px;font-weight:600;line-height:1.2;}
  .rec-card p{font-size:10px;color:var(--text-soft);margin-top:3px;}
  .empty-note{font-size:13px;color:var(--text-soft);text-align:center;padding:30px 0;}
  .field-label{font-size:11.5px;font-weight:600;color:var(--text-soft);display:block;margin:14px 0 6px;}

  /* Checkout modal */
  .modal-overlay{position:fixed;inset:0;background:rgba(10,10,10,.55);z-index:210;opacity:0;pointer-events:none;transition:opacity .3s;display:flex;align-items:center;justify-content:center;padding:20px;}
  .modal-overlay.show{opacity:1;pointer-events:auto;}
  .modal{background:var(--surface);border-radius:22px;max-width:760px;width:100%;max-height:88vh;overflow-y:auto;padding:0;}
  .modal-head{display:flex;align-items:center;justify-content:space-between;padding:22px 26px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--surface);z-index:2;}
  .modal-head h3{font-size:18px;font-weight:700;}
  .modal-body{padding:26px;}
  .steps{display:flex;gap:6px;margin-bottom:24px;}
  .step-pill{flex:1;height:5px;border-radius:99px;background:var(--border);}
  .step-pill.done{background:var(--grad);}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .form-grid.full{grid-template-columns:1fr;}
  .field{display:flex;flex-direction:column;gap:6px;}
  .field label{font-size:11.5px;font-weight:600;color:var(--text-soft);}
  .field input,.field select{border:1px solid var(--border);border-radius:10px;padding:11px 13px;font-size:13px;background:var(--pearl);color:var(--text);}
  .radio-card{display:flex;align-items:center;gap:12px;border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px;cursor:pointer;}
  .radio-card.selected{border-color:var(--magenta);background:rgba(230,59,122,.05);}
  .radio-card .rdot{width:16px;height:16px;border-radius:50%;border:2px solid var(--border);flex:none;position:relative;}
  .radio-card.selected .rdot::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--magenta);}
  .radio-card .rinfo{flex:1;}
  .radio-card h5{font-size:13.5px;font-weight:600;}
  .radio-card span{font-size:11.5px;color:var(--text-soft);}
  .radio-card b{font-size:13px;}
  .summary-box{background:var(--pearl);border-radius:14px;padding:18px;margin-top:6px;}
  .summary-box .row{display:flex;justify-content:space-between;font-size:13px;padding:6px 0;color:var(--text-soft);}
  .summary-box .row.total{color:var(--text);font-weight:700;font-size:16px;border-top:1px solid var(--border);margin-top:6px;padding-top:12px;}
  .terms-row{display:flex;align-items:center;gap:8px;margin:16px 0;font-size:12.5px;color:var(--text-soft);}
  .modal-nav{display:flex;justify-content:space-between;margin-top:22px;gap:10px;}
  .success-box{text-align:center;padding:30px 10px;}
  .success-box .check{width:64px;height:64px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}

  /* Account modal */
  .acc-tabs{display:flex;gap:8px;margin-bottom:20px;}
  .acc-tab{flex:1;padding:10px;border-radius:10px;font-size:12.5px;font-weight:600;background:var(--pearl);text-align:center;color:var(--text-soft);}
  .acc-tab.active{background:var(--grad);color:#fff;}
  .acc-panel{display:none;flex-direction:column;gap:12px;}
  .acc-panel.active{display:flex;}
  .acc-panel input{border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:13px;background:var(--pearl);color:var(--text);width:100%;}
  .acc-panel .link{font-size:12px;color:var(--crimson);font-weight:600;align-self:flex-end;}

  /* Product modal */
  .pmodal-body{display:grid;grid-template-columns:1fr 1fr;gap:26px;padding:26px;}
  .gallery-main{height:280px;border-radius:16px;background:linear-gradient(160deg,var(--pearl),var(--border));display:flex;align-items:center;justify-content:center;color:var(--text-soft);position:relative;overflow:hidden;cursor:zoom-in;}
  .gallery-main.zoomed svg{transform:scale(2.2);}
  .gallery-main svg{transition:transform .2s;}
  .gallery-thumbs{display:flex;gap:8px;margin-top:10px;}
  .gthumb{width:56px;height:56px;border-radius:10px;background:var(--pearl);border:2px solid transparent;display:flex;align-items:center;justify-content:center;color:var(--text-soft);cursor:pointer;}
  .gthumb.active{border-color:var(--magenta);}
  .view360{position:absolute;bottom:8px;right:8px;background:rgba(23,23,23,.7);color:#fff;font-size:10px;font-weight:700;padding:4px 9px;border-radius:999px;}
  .pmodal-info h2{font-size:20px;font-weight:700;}
  .pmodal-tabs{display:flex;gap:4px;margin-top:18px;border-bottom:1px solid var(--border);}
  .pmodal-tab{padding:9px 12px;font-size:12px;font-weight:600;color:var(--text-soft);border-bottom:2px solid transparent;}
  .pmodal-tab.active{color:var(--text);border-color:var(--crimson);}
  .pmodal-tabcontent{display:none;padding:14px 0;font-size:12.5px;color:var(--text-soft);line-height:1.7;}
  .pmodal-tabcontent.active{display:block;}
  .spec-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed var(--border);}
  .stock-line{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:12.5px;}
  .stock-dot{width:8px;height:8px;border-radius:50%;background:#1a9e5c;}
  .stock-dot.out{background:#b5b5b5;}

  /* Compare bar */
  .compare-bar{position:fixed;left:0;right:0;bottom:0;background:var(--graphite);color:#fff;z-index:150;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:14px;transform:translateY(100%);transition:transform .3s;}
  .compare-bar.show{transform:translateY(0);}
  .compare-bar .items{display:flex;gap:10px;font-size:12.5px;color:#c9c9c7;}
  .compare-table{width:100%;border-collapse:collapse;font-size:12.5px;}
  .compare-table th,.compare-table td{padding:10px;border-bottom:1px solid var(--border);text-align:left;}

  /* Toast */
  .toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--graphite);color:#fff;padding:12px 22px;border-radius:999px;font-size:13px;font-weight:600;z-index:300;opacity:0;pointer-events:none;transition:opacity .3s, transform .3s;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* Mobile bottom nav */
  .bottom-nav{display:none;}
  @media (max-width:720px){
    .bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;background:var(--surface);border-top:1px solid var(--border);z-index:120;padding:8px 0 12px;}
    .bottom-nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:9.5px;font-weight:600;color:var(--text-soft);position:relative;}
    .bottom-nav button.active{color:var(--crimson);}
  }

  @media (max-width: 1080px){
    .cat-grid{grid-template-columns:repeat(3,1fr);}
    .prod-grid{grid-template-columns:repeat(3,1fr);}
    .builder{grid-template-columns:1fr;}
    .offers-grid{grid-template-columns:1fr 1fr;}
    .benefits-grid{grid-template-columns:1fr 1fr;}
    .foot-grid{grid-template-columns:1fr 1fr;}
    .pmodal-body{grid-template-columns:1fr;}
  }
  @media (max-width: 720px){
    .nav-links{display:none;}
    .burger{display:flex;}
    .hero-copy h1{font-size:36px;}
    .hero-stage{height:300px;}
    .cat-grid{grid-template-columns:repeat(2,1fr);}
    .prod-grid{grid-template-columns:1fr 1fr;}
    .offers-grid{grid-template-columns:1fr;}
    .benefits-grid{grid-template-columns:1fr;}
    .foot-grid{grid-template-columns:1fr;}
    .wrap{padding:0 20px;}
    .form-grid{grid-template-columns:1fr;}
    .back-top{bottom:80px;}
  }

{% endstyle %}



